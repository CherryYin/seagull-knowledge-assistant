    "profiles:install": "pnpm --dir dsh-harness run build:lib:host && pnpm --dir .dsh/profiles/headless install && pnpm --dir .dsh/profiles/web install",
    "profiles:check": "node scripts/check-profiles.mjs",
    "sessions:verify-shadow": "node scripts/verify-session-shadow.mjs",
    "sessions:stage-e-status": "npm run sessions:verify-shadow && node scripts/check-stage-e-readiness.mjs",
    "test:pkg-client": "node --test scripts/pkg-client-readonly.test.mjs",
    "test:pkg-web-search": "node --test plugins/pkg-web-search/test/plugin.test.js",
    "test:asset-block-patch": "node --test plugins/asset-block-patch/test/plugin.test.js",
    "test:sessions:verify-shadow": "node --test scripts/verify-session-shadow.test.mjs",
    "test:sessions:stage-e": "node --test scripts/check-stage-e-readiness.test.mjs",
    "test:agent-memory": "node --test plugins/agent-memory/test/store.test.js",
    "test:session-context": "node --test plugins/session-context/test/store.test.js",
    "test:agent-memory-migration": "node --test scripts/migrate-agent-memory-to-postgres.test.mjs",
    "agent-memory:migrate-postgres": "node scripts/migrate-agent-memory-to-postgres.mjs",
    "smoke:agent-memory-postgres": "node scripts/check-agent-memory-postgres.mjs",
    "test:agent-memory-integration": "node scripts/check-agent-memory-integration.mjs",
    "test:research-pilot": "node scripts/check-research-pilot.mjs",
    "test:asset-production-integration": "node scripts/check-asset-production-integration.mjs",
    "test:settings-integration": "node scripts/check-shared-settings-integration.mjs",
    "smoke:four-services": "../personal_knowledge_graph/.venv/bin/python scripts/smoke-four-services.py",
    "stack:check": "bash scripts/dev-stack.sh check",
    "stack:start": "bash scripts/dev-stack.sh start",
    "stack:stop": "bash scripts/dev-stack.sh stop",
    "stack:restart": "bash scripts/dev-stack.sh restart",
    "stack:status": "bash scripts/dev-stack.sh status",
    "stack:logs": "bash scripts/dev-stack.sh logs",
    "run-headless": "DSH_HOME=./.dsh node dsh-harness/apps/cli/lib/bin.js --profile headless",
    "run-web": "DSH_HOME=./.dsh node dsh-harness/apps/cli/lib/bin.js --profile web"
