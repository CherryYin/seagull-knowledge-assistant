{
  "name": "personal-knowledge-graph",
  "private": true,
  "description": "Root npm scripts delegate to web/ (Vite + React UI).",
  "scripts": {
    "dev": "npm --prefix web run dev",
    "dev:all": "bash ./scripts/dev.sh",
    "dev:all-bg": "bash ./scripts/dev-bg.sh",
    "dev:status": "bash ./scripts/dev-status.sh",
    "dev:stop": "bash ./scripts/dev-stop.sh",
    "build": "npm --prefix web run build",
    "preview": "npm --prefix web run preview",
    "install:web": "npm --prefix web install"
  }
}
