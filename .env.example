POSTGRES_DB=knowledge_graph
POSTGRES_USER=kg_user
POSTGRES_PASSWORD=local-dev-postgres-password
DATABASE_URL=postgresql+asyncpg://kg_user:local-dev-postgres-password@localhost:5433/knowledge_graph
DATABASE_URL_SYNC=postgresql+psycopg://kg_user:local-dev-postgres-password@localhost:5433/knowledge_graph
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=local-dev-minio-password
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=local-dev-minio-password
MINIO_BUCKET=knowledge-graph
MINIO_REGION=us-east-1
MINIO_PRESIGNED_EXPIRY_SECONDS=3600
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
DATA_DIR=./data

# Docling PDF: OCR + table structure are on by default (good for scanned PDFs; first load is slow on CPU).
# DOCLING_OCR=false
# DOCLING_TABLE_STRUCTURE=false
# RapidOCR: onnxruntime (default, needs package onnxruntime) is fastest on CPU; alternatives: torch, paddle, openvino.
 DOCLING_RAPIDOCR_BACKEND=onnxruntime
# DOCLING_OCR_USE_ANGLE_CLS=false
# Old/mismatched NVIDIA driver (e.g. WSL): skip CUDA probe before PyTorch loads.
# KG_TORCH_CPU_ONLY=true

# LLM provider: "azure" or "qwen"
LLM_PROVIDER=qwen

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Qwen API (DashScope OpenAI-compatible)
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=your-key-here
QWEN_MODEL=qwen-plus
