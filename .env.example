PORT=4000
HOST=127.0.0.1
PKG_API_URL=http://127.0.0.1:8000
HARNESS_API_URL=http://127.0.0.1:3080
UI_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Must match the Harness process. Replace for any non-loopback deployment.
HARNESS_SERVICE_TOKEN=replace-with-a-random-service-token
SESSION_AUTH_TTL_MS=28800000

# PostgreSQL is the default for multi-instance Agent Memory. Run the Lab migration first.
AGENT_MEMORY_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/knowledge_graph
AGENT_MEMORY_DATABASE_SCHEMA=public
# Set AGENT_MEMORY_STORE_PATH only for isolated local/file-backed runs.
