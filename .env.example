POSTGRES_DB=knowledge_graph
POSTGRES_USER=kg_user
POSTGRES_PASSWORD=local-dev-postgres-password
DATABASE_URL=postgresql+asyncpg://kg_user:local-dev-postgres-password@localhost:5433/knowledge_graph
DATABASE_URL_SYNC=postgresql+psycopg://kg_user:local-dev-postgres-password@localhost:5433/knowledge_graph
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=local-dev-minio-password
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=local-dev-minio-password
MINIO_BUCKET=knowledge-graph
MINIO_REGION=us-east-1
MINIO_PRESIGNED_EXPIRY_SECONDS=3600
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
DATA_DIR=./data
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
ADMIN_INIT_PASSWORD=replace-with-strong-admin-password

# Docling PDF: OCR + table structure are on by default (good for scanned PDFs; first load is slow on CPU).
# DOCLING_OCR=false
# DOCLING_TABLE_STRUCTURE=false
# RapidOCR: onnxruntime (default, needs package onnxruntime) is fastest on CPU; alternatives: torch, paddle, openvino.
 DOCLING_RAPIDOCR_BACKEND=onnxruntime
# DOCLING_OCR_USE_ANGLE_CLS=false
# Old/mismatched NVIDIA driver (e.g. WSL): skip CUDA probe before PyTorch loads.
# KG_TORCH_CPU_ONLY=true

# LLM provider: "azure" or "qwen"
LLM_PROVIDER=qwen

# Inject repository workspace profile into the default in-app Action Agent prompt.
AGENT_LOAD_WORKSPACE_PROFILE=true
AGENT_WORKSPACE_PROFILE_PATH=AGENTS.md
AGENT_WORKSPACE_PROFILE_MAX_CHARS=12000

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Qwen API (DashScope OpenAI-compatible)
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=your-key-here
QWEN_MODEL=qwen-plus

# MiniMax API (OpenAI-compatible)
MINIMAX_API_BASE=https://api.minimax.io/v1
MINIMAX_API_KEY=your-key-here
# Set this to the actual model id returned by your MiniMax account /models endpoint.
# If your account has M3 access, use that exact id here.
MINIMAX_MODEL=

# Preferred multi-provider registry. Example:
# LLM_PROVIDERS=[
#   {"id":"qwen","display_name":"Qwen","base_url":"https://dashscope.aliyuncs.com/compatible-mode/v1","api_key_env":"QWEN_API_KEY","default_model":"qwen-plus"},
#   {"id":"minimax","display_name":"MiniMax","base_url":"https://api.minimax.io/v1","api_key_env":"MINIMAX_API_KEY","default_model":"YOUR_MINIMAX_MODEL_ID"}
# ]

# Tavily Web Search for Discover external web ingestion
TAVILY_API_KEY=

# RSS fetch and summarization controls
RSS_FETCH_INTERVAL_HOURS=24
RSS_SUMMARY_LLM_TIMEOUT=180
RSS_SUMMARY_MAX_ARTICLES=12
RSS_SUMMARY_MAX_CHARS_PER_ARTICLE=1500
RSS_AUTO_FETCH_ENABLED=false
RSS_AUTO_SUMMARY_ENABLED=false
CONNECTOR_TRENDS_AUTO_ENABLED=false
DISCOVERY_AUTO_GENERATE_ENABLED=false
PAPER_DISCOVERY_AUTO_ENABLED=false

# Paper / scholarly APIs
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=
OPENALEX_POLITE_EMAIL=
