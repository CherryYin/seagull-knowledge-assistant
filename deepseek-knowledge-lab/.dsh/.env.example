# DeepSeek API Key (required)
DEEPSEEK_API_KEY=sk-your-key-here

# PKG 工具统一通过 Seagull BFF，认证按 Harness Session 自动转发
PKG_GATEWAY_URL=http://127.0.0.1:4000/internal/pkg

# 生产/非回环部署必须替换，并与 BFF 的 HARNESS_SERVICE_TOKEN 保持一致
HARNESS_SERVICE_TOKEN=replace-with-a-random-service-token

# Stage E: PostgreSQL is the only active Session writer; legacy JSONL files are read-only rollback archives.
# Use a node-postgres compatible URL (postgresql://, without +asyncpg/+psycopg).
PKG_DATABASE_URL=postgresql://pkg:pkg@127.0.0.1:5432/pkg

# ── Kobo Knowledge (Ubisoft) ─────────────────────
KOBO_BASE=https://knowledge-dev.foundry.ubisoft.org/api
KOBO_TOKEN=your-temporary-token-here
